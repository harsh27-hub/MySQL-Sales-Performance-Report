  <DataSources>
    <DataSource Name="MySQL_Sales_Source">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>ODBC</DataProvider>
        <ConnectString>	
DSN=MySQL_Sales;</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>3d3a833d-1af6-4006-918e-5a76eaf886c1</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsSalesDetails">
      <Query>
        <DataSourceName>MySQL_Sales_Source</DataSourceName>
        <CommandText>SELECT
    s.sales_id,
    s.order_date,
    c.customer_name,
    c.region,
    p.product_name,
    p.category,
    s.quantity,
    s.unit_price,
    (s.quantity * s.unit_price) AS total_sales
FROM sales s
INNER JOIN customers c
    ON s.customer_id = c.customer_id
INNER JOIN products p
    ON s.product_id = p.product_id
ORDER BY s.order_date;</CommandText>
      </Query>
      <Fields>
        <Field Name="sales_id">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>sales_id</DataField>
        </Field>
        <Field Name="order_date">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>order_date</DataField>
        </Field>
        <Field Name="customer_name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>customer_name</DataField>
        </Field>
        <Field Name="region">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>region</DataField>
        </Field>
        <Field Name="product_name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>product_name</DataField>
        </Field>
        <Field Name="category">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>category</DataField>
        </Field>
        <Field Name="quantity">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>quantity</DataField>
        </Field>
        <Field Name="unit_price">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>unit_price</DataField>
        </Field>
        <Field Name="total_sales">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>total_sales</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
